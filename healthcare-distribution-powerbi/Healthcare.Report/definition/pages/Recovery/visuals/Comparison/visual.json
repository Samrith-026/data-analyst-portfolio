{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.1.0/schema.json",
  "name": "Comparison",
  "position": {
    "x": 20,
    "y": 250,
    "z": 0,
    "width": 1240,
    "height": 440,
    "tabOrder": 0
  },
  "visual": {
    "visualType": "clusteredColumnChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "DimCustomer"
                    }
                  },
                  "Property": "Region"
                }
              },
              "queryRef": "DimCustomer.Region",
              "nativeQueryRef": "Region"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "FactOrders"
                    }
                  },
                  "Property": "Contribution"
                }
              },
              "queryRef": "FactOrders.Contribution",
              "nativeQueryRef": "Contribution"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "FactOrders"
                    }
                  },
                  "Property": "Scenario Contribution"
                }
              },
              "queryRef": "FactOrders.Scenario Contribution",
              "nativeQueryRef": "Scenario Contribution"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Contribution vs scenario: gross opportunity before implementation cost'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}