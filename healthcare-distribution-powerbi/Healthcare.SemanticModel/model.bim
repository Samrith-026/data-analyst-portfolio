            "formatString": "0%"
          }
        ],
        "partitions": [
          {
            "name": "Recovery",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(Binary.Decompress(Binary.FromText(\"Hcy5DYAwFETB3MUgf/BFG3RAQAf0L3sczOpF+7z/l/KRqWsCcSIuREFspiE6YiBuaor1PAE=\", BinaryEncoding.Base64), Compression.Deflate), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
