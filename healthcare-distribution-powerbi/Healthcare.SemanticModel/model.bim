                "    Typed"
              ]
            }
          }
        ]
      },
      {
        "name": "FactOrders",
        "columns": [
          {
            "name": "OrderKey",
            "dataType": "int64",
            "sourceColumn": "OrderKey",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "OrderDate",
            "dataType": "dateTime",
            "sourceColumn": "OrderDate",
            "summarizeBy": "none",
            "formatString": "yyyy-MM-dd"
          },
          {
            "name": "ProductKey",
            "dataType": "int64",
            "sourceColumn": "ProductKey",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "CustomerKey",
            "dataType": "int64",
            "sourceColumn": "CustomerKey",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "CarrierKey",
            "dataType": "int64",
            "sourceColumn": "CarrierKey",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "Units",
            "dataType": "int64",
            "sourceColumn": "Units",
            "summarizeBy": "none"
          },
          {
            "name": "GrossSales",
            "dataType": "decimal",
            "sourceColumn": "GrossSales",
            "summarizeBy": "none"
          },
          {
            "name": "Discount",
            "dataType": "decimal",
            "sourceColumn": "Discount",
            "summarizeBy": "none"
          },
          {
            "name": "Refund",
            "dataType": "decimal",
            "sourceColumn": "Refund",
            "summarizeBy": "none"
          },
          {
            "name": "COGS",
            "dataType": "decimal",
            "sourceColumn": "COGS",
            "summarizeBy": "none"
          },
          {
            "name": "Freight",
            "dataType": "decimal",
            "sourceColumn": "Freight",
            "summarizeBy": "none"
          },
          {
            "name": "Penalty",
            "dataType": "decimal",
            "sourceColumn": "Penalty",
            "summarizeBy": "none"
          },
          {
            "name": "Expedite",
            "dataType": "decimal",
            "sourceColumn": "Expedite",
            "summarizeBy": "none"
          },
          {
            "name": "OnTime",
            "dataType": "int64",
            "sourceColumn": "OnTime",
            "summarizeBy": "none"
          },
          {
            "name": "InFull",
            "dataType": "int64",
            "sourceColumn": "InFull",
            "summarizeBy": "none"
          },
          {
            "name": "DelayDays",
            "dataType": "int64",
            "sourceColumn": "DelayDays",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "FactOrders",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(Binary.Decompress(Binary.FromText(\"\", BinaryEncoding.Base64), Compression.Deflate), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"OrderKey\", Int64.Type}, {\"OrderDate\", type date}, {\"ProductKey\", Int64.Type}, {\"CustomerKey\", Int64.Type}, {\"CarrierKey\", Int64.Type}, {\"Units\", Int64.Type}, {\"GrossSales\", Currency.Type}, {\"Discount\", Currency.Type}, {\"Refund\", Currency.Type}, {\"COGS\", Currency.Type}, {\"Freight\", Currency.Type}, {\"Penalty\", Currency.Type}, {\"Expedite\", Currency.Type}, {\"OnTime\", Int64.Type}, {\"InFull\", Int64.Type}, {\"DelayDays\", Int64.Type}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Orders",
            "expression": "COUNTROWS(FactOrders)",
            "formatString": "#,0",
            "displayFolder": "Volume"
          },
          {
            "name": "Gross Sales",
            "expression": "SUM(FactOrders[GrossSales])",
            "formatString": "$#,0",
            "displayFolder": "Financial"
          },
          {
            "name": "Discounts",
            "expression": "SUM(FactOrders[Discount])",
            "formatString": "$#,0",
            "displayFolder": "Financial"
          },
          {
            "name": "Refunds",
            "expression": "SUM(FactOrders[Refund])",
            "formatString": "$#,0",
            "displayFolder": "Financial"
          },
          {
            "name": "Net Revenue",
            "expression": "[Gross Sales] - [Discounts] - [Refunds]",
            "formatString": "$#,0",
            "displayFolder": "Financial"
          },
          {
            "name": "Product Cost",
            "expression": "SUM(FactOrders[COGS])",
            "formatString": "$#,0",
            "displayFolder": "Financial"
          },
          {
            "name": "Base Freight",
            "expression": "SUM(FactOrders[Freight])",
            "formatString": "$#,0",
            "displayFolder": "Financial"
          },
          {
            "name": "Service Failure Cost",
            "expression": "SUM(FactOrders[Penalty]) + SUM(FactOrders[Expedite])",
            "formatString": "$#,0",
            "displayFolder": "Financial"
          },
          {
            "name": "Contribution",
            "expression": "[Net Revenue] - [Product Cost] - [Base Freight] - [Service Failure Cost]",
            "formatString": "$#,0",
            "displayFolder": "Financial"
          },
          {
            "name": "Contribution Margin",
            "expression": "DIVIDE([Contribution], [Net Revenue])",
            "formatString": "0.0%",
            "displayFolder": "Financial"
          },
          {
            "name": "On Time Rate",
            "expression": "DIVIDE(SUM(FactOrders[OnTime]), [Orders])",
            "formatString": "0.0%",
            "displayFolder": "Service"
          },
          {
            "name": "OTIF Rate",
            "expression": "DIVIDE(CALCULATE([Orders], KEEPFILTERS(FactOrders[OnTime] = 1), KEEPFILTERS(FactOrders[InFull] = 1)), [Orders])",
            "formatString": "0.0%",
            "displayFolder": "Service"
          },
          {
            "name": "Late Orders",
            "expression": "CALCULATE([Orders], KEEPFILTERS(FactOrders[OnTime] = 0))",
            "formatString": "#,0",
            "displayFolder": "Service"
          },
          {
            "name": "Average Late Days",
            "expression": "CALCULATE(AVERAGE(FactOrders[DelayDays]), KEEPFILTERS(FactOrders[DelayDays] > 0))",
            "formatString": "0.00",
            "displayFolder": "Service"
          },
          {
            "name": "Revenue PY",
            "expression": "CALCULATE([Net Revenue], DATEADD(DimDate[Date], -1, YEAR))",
            "formatString": "$#,0",
            "displayFolder": "Time intelligence"
          },
          {
            "name": "Revenue YoY",
            "expression": "DIVIDE([Net Revenue] - [Revenue PY], [Revenue PY])",
            "formatString": "0.0%",
            "displayFolder": "Time intelligence"
          },
          {
            "name": "Revenue YTD",
            "expression": "TOTALYTD([Net Revenue], DimDate[Date])",
            "formatString": "$#,0",
            "displayFolder": "Time intelligence"
          },
          {
            "name": "Recovery Rate",
            "expression": "SELECTEDVALUE(Recovery[Rate], 0.25)",
            "formatString": "0%",
            "displayFolder": "Scenario"
          },
          {
            "name": "Potential Recovery",
            "expression": "[Service Failure Cost] * [Recovery Rate]",
            "formatString": "$#,0",
            "displayFolder": "Scenario"
          },
          {
            "name": "Scenario Contribution",
            "expression": "[Contribution] + [Potential Recovery]",
            "formatString": "$#,0",
            "displayFolder": "Scenario"
          },
          {
            "name": "Scenario Margin",
            "expression": "DIVIDE([Scenario Contribution], [Net Revenue])",
            "formatString": "0.0%",
            "displayFolder": "Scenario"
          }
        ]
      }
    ],
    "relationships": [
      {
        "name": "Orders_DimDate",
        "fromTable": "FactOrders",
        "fromColumn": "OrderDate",
        "toTable": "DimDate",
        "toColumn": "Date",
        "fromCardinality": "many",
        "toCardinality": "one",
        "crossFilteringBehavior": "oneDirection"
      },
      {
        "name": "Orders_DimProduct",
        "fromTable": "FactOrders",
        "fromColumn": "ProductKey",
        "toTable": "DimProduct",
        "toColumn": "ProductKey",
        "fromCardinality": "many",
        "toCardinality": "one",
        "crossFilteringBehavior": "oneDirection"
      },
      {
        "name": "Orders_DimCustomer",
        "fromTable": "FactOrders",
        "fromColumn": "CustomerKey",
        "toTable": "DimCustomer",
        "toColumn": "CustomerKey",
        "fromCardinality": "many",
        "toCardinality": "one",
        "crossFilteringBehavior": "oneDirection"
      },
      {
        "name": "Orders_DimCarrier",
        "fromTable": "FactOrders",
        "fromColumn": "CarrierKey",
        "toTable": "DimCarrier",
        "toColumn": "CarrierKey",
        "fromCardinality": "many",
        "toCardinality": "one",
        "crossFilteringBehavior": "oneDirection"
      }
    ]
  }
}