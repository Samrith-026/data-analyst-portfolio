            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(Binary.Decompress(Binary.FromText(\"c04sKspMLfJOrdRxhjC5DGEsBUcuIzjbicsYznbmAgA=\", BinaryEncoding.Base64), Compression.Deflate), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"CarrierKey\", Int64.Type}, {\"Carrier\", type text}}, \"en-US\")",
                "in",
